{
  "name": "ekshamatawebautomation",
  "version": "1.0.0",
  "description": "Playwright web-portal automation for Ekshamata (https://ekshamata.aastrika.org). Data (orgs, users, provisioning) replicated from the Ekshamata mobile suite at D:\\Mobile automation.",
  "scripts": {
    "test": "playwright test --project=Chrome",
    "test:orgs": "playwright test --project=orgs",
    "test:bnrc": "cross-env USE_EXISTING_USER=1 BASE_URL=https://ekshamata.aastrika.org playwright test tests/orgs/BNRC.spec.ts --project=orgs --headed",
    "test:all": "playwright test",
    "smoke": "playwright test tests/smoke.spec.ts --project=Chrome --headed",
    "login": "playwright test tests/login.spec.ts --project=Chrome --headed",
    "run:stepper": "node scripts/run-stepper.mjs",
    "run:stepper:direct": "cross-env BASE_URL=https://ekshamata.aastrika.org playwright test tests/competency-stepper.spec.ts --project=Chrome --headed",
    "//compare": "── Environment comparison (prod vs staging, side by side) ──",
    "compare": "node scripts/run-compare.mjs",
    "compare:bnrc": "node scripts/compare-env.mjs --auth --org BNRC --no-catalogue --open",
    "compare:orgs": "node scripts/compare-orgs.mjs",
    "compare:all": "node scripts/compare-env.mjs --auth --open",
    "compare:org": "node scripts/compare-env.mjs --auth --no-catalogue --open",
    "compare:local": "node scripts/compare-env.mjs --b http://localhost:3000",
    "compare:users": "node scripts/compare-env.mjs --users",
    "test:org-content": "cross-env BASE_URL=https://ekshamata.aastrika.org playwright test tests/org-content.spec.ts --project=Chrome --headed",
    "run:clicks": "cross-env BASE_URL=https://ekshamata.aastrika.org playwright test tests/ekshamata-clicks.spec.ts --project=Chrome --headed",
    "run:create-user-test": "cross-env BASE_URL=https://ekshamata.aastrika.org playwright test tests/user-creation.spec.ts --project=Chrome --headed",
    "create:user": "node scripts/create-user.mjs",
    "verify:account": "node scripts/verify-account.mjs",
    "//users": "── Provision users (per environment — the backends are separate) ──",
    "create:pair": "node scripts/create-user-pair.mjs",
    "create:creds": "node -r ts-node/register scripts/create-users.ts",
    "create:user:prod": "cross-env BASE_URL=https://ekshamata.aastrika.org playwright test tests/create-env-user.spec.ts --project=Chrome",
    "create:user:stage": "cross-env BASE_URL=https://ekshamata-staging.aastrika.org playwright test tests/create-env-user.spec.ts --project=Chrome",
    "run:competency": "node scripts/climb-competency.mjs",
    "climb:bnrc": "node scripts/climb-competency.mjs BNRC",
    "climb:dmhup": "node scripts/climb-competency.mjs DMHUP",
    "climb:pvtbihar": "node scripts/climb-competency.mjs PVTBIHAR",
    "climb:pvtup": "node scripts/climb-competency.mjs PVTUP",
    "climb:shsb": "node scripts/climb-competency.mjs SHSB",
    "//course": "── Complete a whole course (every module) ──",
    "run:course": "node scripts/run-course.mjs",
    "run:course:prod": "cross-env BASE_URL=https://ekshamata.aastrika.org playwright test tests/course-complete.spec.ts --project=Chrome --headed",
    "run:course:stage": "cross-env BASE_URL=https://ekshamata-staging.aastrika.org playwright test tests/course-complete.spec.ts --project=Chrome --headed",
    "test:badge": "playwright test tests/account-badge.spec.ts --project=Chrome",
    "test:badge:mp": "cross-env ORG=MP playwright test tests/account-badge.spec.ts --project=Chrome --headed",
    "//certificate": "── Consume a course and collect its certificate ──",
    "run:certificate": "node scripts/run-course.mjs --certificate",
    "run:certificate:only": "node scripts/run-course.mjs --certificate-only",
    "run:certificate:only:prod": "cross-env BASE_URL=https://ekshamata.aastrika.org playwright test tests/certificate.spec.ts --project=Chrome --headed",
    "run:certificate:only:stage": "cross-env BASE_URL=https://ekshamata-staging.aastrika.org playwright test tests/certificate.spec.ts --project=Chrome --headed",
    "courses:list": "node scripts/run-course.mjs --list",
    "courses:list:stage": "node scripts/run-course.mjs --stage --list",
    "test:regression": "cross-env HEADLESS=true BASE_URL=https://ekshamata.aastrika.org REPORT_LABEL=regression playwright test tests/ekshamata-clicks.spec.ts tests/user-creation.spec.ts tests/org-content.spec.ts tests/orgs/ tests/login.spec.ts tests/smoke.spec.ts",
    "report": "playwright show-report",
    "report:brand": "node -e \"console.log('Open: '+require('path').resolve('brand-reports/latest.html'))\"",
    "roles": "node scripts/run-roles.mjs",
    "roles:all": "node scripts/run-roles.mjs --all"
  },
  "keywords": [
    "ekshamata",
    "playwright",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.9.1",
    "cross-env": "^10.1.0",
    "exceljs": "^4.4.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
