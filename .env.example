# ── Target environment ─────────────────────────────────────────────
# Localhost by default (local Ekshamata web dev server). Uncomment the live
# URL to run against production instead.
BASE_URL=http://localhost:3000
# BASE_URL=https://ekshamata.aastrika.org

# Run headless (CI). Leave unset/false for a visible browser.
HEADLESS=false

# ── Existing account used by tests/login.spec.ts ───────────────────
EKSHAMATA_EMAIL=SHSB001@yopmail.com
EKSHAMATA_PASSWORD=Aastrika@123

# ── Sphere user-provisioning APIs (tests/orgs/* create fresh users) ──
# SESSION creds — they EXPIRE. Refresh from Postman / DevTools when calls 401.
SPHERE_BASE_URL=https://sphere.aastrika.org
SPHERE_API_TOKEN=
SPHERE_API_COOKIE=
# Password set on every freshly-created user (must match the login form).
EKSHAMATA_USER_PASSWORD=Aastrika@123
